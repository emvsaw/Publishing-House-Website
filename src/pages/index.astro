---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allAuthors = await getCollection('authors');
const allBooks = await getCollection('books');

const featuredBooks = allBooks.filter(b => b.data.featured);
const genres = [...new Set(allBooks.map(b => b.data.genre))].sort();

// Build a lookup for author names
const authorMap = Object.fromEntries(allAuthors.map(a => [a.data.slug, a.data]));

// Normalize paid books and free reader magnets into one card shape, then mix
// across pens (round-robin) so genres alternate instead of clustering by date.
// Within each pen: the free book first, then the series in order.
const cardsByAuthor = new Map();
const bucketFor = (slug) => {
  if (!cardsByAuthor.has(slug)) cardsByAuthor.set(slug, { free: null, books: [] });
  return cardsByAuthor.get(slug);
};

for (const a of allAuthors) {
  if (a.data.freeBook) {
    bucketFor(a.data.slug).free = {
      kind: 'free',
      title: a.data.freeBook.title,
      cover: a.data.freeBook.cover,
      authorSlug: a.data.slug,
      genre: a.data.genres?.[0] ?? 'Free Book',
      freeUrl: `/free/${a.data.slug}/`,
    };
  }
}
for (const b of allBooks) {
  const bucket = bucketFor(b.data.authorSlug);
  // A pen's reader magnet may also exist as a book file (e.g. a free prequel).
  // Skip the paid-style card so it only shows once, as the free card.
  if (bucket.free && bucket.free.title.trim().toLowerCase() === b.data.title.trim().toLowerCase()) continue;
  bucket.books.push({
    kind: 'book',
    title: b.data.title,
    cover: b.data.cover,
    authorSlug: b.data.authorSlug,
    genre: b.data.genre,
    amazon: b.data.buyLinks?.amazon,
    releaseDate: b.data.releaseDate,
  });
}

const authorCardLists = [...cardsByAuthor.values()].map(({ free, books }) => {
  books.sort((a, b) => new Date(a.releaseDate).getTime() - new Date(b.releaseDate).getTime());
  return free ? [free, ...books] : books;
});
const totalCards = authorCardLists.reduce((n, l) => n + l.length, 0);
const mixedBooks = [];
for (let i = 0; mixedBooks.length < totalCards; i++) {
  for (const list of authorCardLists) {
    if (list[i]) mixedBooks.push(list[i]);
  }
}
---

<BaseLayout title="Redwood Bay Press | Bold Stories, Unforgettable Voices">

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>Redwood Bay Press</h1>
      <p class="tagline">Bold stories. Unforgettable voices.</p>
      <p class="mission">
        We're an indie publishing house championing fresh, heartfelt fiction across historical mystery,
        cozy mystery, omegaverse romantasy, and romantic comedy. Every book we publish is a story we
        couldn't put down, and neither will you.
      </p>
    </div>
  </section>

  <!-- Featured Authors -->
  <section class="section" id="authors">
    <div class="container">
      <div class="section-title">
        <span>Our Authors</span>
        <h2>Featured Authors</h2>
      </div>
      <div class="author-grid">
        {allAuthors.map(author => (
          <a href={`/authors/${author.data.slug}/`} class="card author-card" style="text-decoration:none; color:inherit;">
            <img
              src={author.data.photo}
              alt={author.data.name}
              class="avatar"
              loading="lazy"
            />
            <div class="meta">
              <h3>{author.data.name}</h3>
              <p class="genres">{author.data.genres.join(' · ')}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Browse by Genre + Book Grid -->
  <section class="section" id="books">
    <div class="container">
      <div class="section-title">
        <span>Browse</span>
        <h2>Our Books</h2>
      </div>

      <!-- Genre filters -->
      <div class="filter-bar" id="genre-filters">
        <button class="tag active" data-genre="all">All</button>
        {genres.map(genre => (
          <button class="tag" data-genre={genre}>{genre}</button>
        ))}
      </div>

      <!-- Author filters -->
      <div class="filter-bar" id="author-filters">
        <button class="tag active" data-author="all">All Authors</button>
        {allAuthors.map(author => (
          <button class="tag" data-author={author.data.slug}>{author.data.name}</button>
        ))}
      </div>

      <!-- Book grid -->
      <div class="book-grid" id="book-grid">
        {mixedBooks
          .map(card => {
            const author = authorMap[card.authorSlug];
            return (
              <div class="card book-card" data-genre={card.genre} data-author={card.authorSlug}>
                <div class="cover-wrap">
                  {card.kind === 'free' && <span class="free-flag">Free</span>}
                  <img src={card.cover} alt={card.title} loading="lazy" />
                </div>
                <div class="info">
                  <h4>{card.title}</h4>
                  <p class="author-name">{author?.name ?? card.authorSlug}</p>
                  <span class="tag genre-tag">{card.genre}</span>
                  {card.kind === 'free' ? (
                    <a href={card.freeUrl} class="btn btn-dark">Get It Free</a>
                  ) : card.amazon ? (
                    <a href={card.amazon} class="btn btn-dark" target="_blank" rel="noopener">Buy on Amazon</a>
                  ) : (
                    <span class="btn-soon">Coming Soon</span>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Newsletter -->
  <section class="newsletter-banner" id="newsletter">
    <div class="container">
      <h2>Stay in the Loop</h2>
      <p>Subscribe to the Redwood Bay Press newsletter for updates from our publisher and our authors.</p>
      <form id="main-newsletter-form">
        <input type="text" name="fields[name]" placeholder="Name" autocomplete="given-name" />
        <input type="email" name="fields[email]" placeholder="Email" autocomplete="email" required />
        <button type="submit" class="btn btn-primary" style="white-space:nowrap;">Get Updates</button>
      </form>
      <p id="newsletter-success" style="display:none; color:var(--color-white); font-weight:600; margin-top:var(--space-sm);">Thank you! You're on the list.</p>
    </div>
  </section>

</BaseLayout>

<script>
  // ── Client-side filtering ──
  const genreButtons = document.querySelectorAll<HTMLButtonElement>('#genre-filters .tag');
  const authorButtons = document.querySelectorAll<HTMLButtonElement>('#author-filters .tag');
  const bookCards = document.querySelectorAll<HTMLElement>('#book-grid .book-card');

  let activeGenre = 'all';
  let activeAuthor = 'all';

  function filterBooks() {
    bookCards.forEach(card => {
      const matchGenre = activeGenre === 'all' || card.dataset.genre === activeGenre;
      const matchAuthor = activeAuthor === 'all' || card.dataset.author === activeAuthor;
      card.style.display = matchGenre && matchAuthor ? '' : 'none';
    });
  }

  genreButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      genreButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeGenre = btn.dataset.genre ?? 'all';
      filterBooks();
    });
  });

  authorButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      authorButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeAuthor = btn.dataset.author ?? 'all';
      filterBooks();
    });
  });

  // ── Newsletter submit ──
  const nlForm = document.getElementById('main-newsletter-form') as HTMLFormElement;
  nlForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(nlForm);
    formData.append('ml-submit', '1');
    formData.append('anticsrf', 'true');
    try {
      await fetch('https://assets.mailerlite.com/jsonp/YOUR_ACCOUNT_ID/forms/YOUR_FORM_ID/subscribe', {
        method: 'POST',
        body: formData,
        mode: 'no-cors',
      });
    } catch (_) {}
    nlForm.style.display = 'none';
    document.getElementById('newsletter-success')!.style.display = 'block';
  });
</script>
