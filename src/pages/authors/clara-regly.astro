<script>
  const mlSlides = document.querySelectorAll('.ml-hero-slide') as NodeListOf<HTMLElement>;
  const mlDots = document.querySelectorAll('.ml-hero-dot') as NodeListOf<HTMLButtonElement>;
  const mlPrev = document.getElementById('mlHeroPrev');
  const mlNext = document.getElementById('mlHeroNext');
  let mlCurrent = 0;
  let mlTimer: ReturnType<typeof setInterval>;

  function mlGoToSlide(index: number) {
    mlSlides[mlCurrent]?.classList.remove('active');
    mlDots[mlCurrent]?.classList.remove('active');
    mlCurrent = (index + mlSlides.length) % mlSlides.length;
    mlSlides[mlCurrent]?.classList.add('active');
    mlDots[mlCurrent]?.classList.add('active');
  }

  function mlResetAuto() {
    clearInterval(mlTimer);
    mlTimer = setInterval(() => mlGoToSlide(mlCurrent + 1), 6000);
  }

  mlPrev?.addEventListener('click', () => { mlGoToSlide(mlCurrent - 1); mlResetAuto(); });
  mlNext?.addEventListener('click', () => { mlGoToSlide(mlCurrent + 1); mlResetAuto(); });
  mlDots.forEach(dot => dot.addEventListener('click', () => {
    mlGoToSlide(Number(dot.dataset.dot));
    mlResetAuto();
  }));
  if (mlSlides.length > 1) mlResetAuto();
</script>
