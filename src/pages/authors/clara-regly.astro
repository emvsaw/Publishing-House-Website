---
import AuthorLandingLayout from '../../layouts/AuthorLandingLayout.astro';
import { getCollection } from 'astro:content';

const allAuthors = await getCollection('authors');
const allBooks = await getCollection('books');

const author = allAuthors.find(a => a.data.slug === 'clara-regly')!.data;
const books = allBooks
  .filter(b => b.data.authorSlug === 'clara-regly')
  .sort((a, b) => new Date(b.data.releaseDate).getTime() - new Date(a.data.releaseDate).getTime());

const freeTitle = author.freeBook?.title?.trim().toLowerCase();
const soonTitle = author.comingSoon?.title?.trim().toLowerCase();
// Keep the free reader magnet in its own opt-in bar; show every other book in the carousel.
const heroBooks = books.filter(b => b.data.title.trim().toLowerCase() !== freeTitle);
const listable = books.filter(b => b.data.title.trim().toLowerCase() !== freeTitle && b.data.title.trim().toLowerCase() !== soonTitle);
const latestReleases = listable.slice(0, 2);
// "All Books" = the complete catalogue (every title), in series order (oldest first).
const fullCatalog = [...books].sort((a, b) => new Date(a.data.releaseDate).getTime() - new Date(b.data.releaseDate).getTime());
// The Coming Soon banner's cover is author frontmatter, but it usually also
// exists as a real book entry — link to that book's page when it matches.
const comingSoonBook = soonTitle ? books.find(b => b.data.title.trim().toLowerCase() === soonTitle) : undefined;
---

<AuthorLandingLayout title={`${author.name} | Historical Mystery Author`} description={`Books by ${author.name}. Art, forgery, and quiet courage in 1920s Europe.`} authorName={author.name}>

  <!-- HERO: Book Carousel -->
  <section class="ml-hero" id="books">
    <div class="ml-hero-carousel" id="mlHeroCarousel">
      {heroBooks.map((book, i) => (
        <div class={`ml-hero-slide ${i === 0 ? 'active' : ''}`} data-index={i}>
          <div class="ml-hero-inner container">
            <div class="ml-hero-text">
              <h1 class="ml-hero-title"><a href={`/books/${book.id}/`}>{book.data.title}</a></h1>
              <p class="ml-hero-tagline">An authenticator with a sharp eye. A Europe full of beautiful lies.</p>
              <p class="ml-hero-blurb">{book.data.blurb}</p>
              <div class="ml-hero-actions">
                {book.data.buyLinks?.amazon ? (
                  <a href={book.data.buyLinks.amazon} class="ml-hero-btn" target="_blank" rel="noopener">
                    Start Reading
                  </a>
                ) : (
                  <span class="ml-hero-btn ml-hero-btn--soon">Coming Soon</span>
                )}
                <a href={`/books/${book.id}/`} class="ml-hero-link">Read More &rarr;</a>
              </div>
            </div>
            <div class="ml-hero-cover">
              <a href={`/books/${book.id}/`}>
                <img src={book.data.cover} alt={book.data.title} />
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
    <button class="ml-hero-arrow ml-hero-arrow--left" id="mlHeroPrev" aria-label="Previous book">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="ml-hero-arrow ml-hero-arrow--right" id="mlHeroNext" aria-label="Next book">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="ml-hero-dots" aria-label="Book carousel navigation">
      {heroBooks.map((book, i) => (
        <button class={`ml-hero-dot ${i === 0 ? 'active' : ''}`} data-dot={i} aria-label={`Show ${book.data.title}`}></button>
      ))}
    </div>
  </section>

  <!-- Opt-in -->
  <div class="ml-optin-bar">
    <div class="container">
      <div class="al-optin" id="newsletter">
        {author.freeBook && (
          <a class="ml-freebook-cover" href={`/free/${author.slug}/`} aria-label={`Get ${author.freeBook.title} free`}>
            <img src={author.freeBook.cover} alt={author.freeBook.title} loading="lazy" />
          </a>
        )}
        <div class="al-optin-text">
          <h2><mark class="ml-optin-highlight">Get {author.freeBook ? `"${author.freeBook.title}"` : 'a Free Book'} from {author.name}</mark></h2>
          <p>{author.freeBook?.blurb ?? 'Join the mailing list for exclusive content, new release alerts, and the free Authenticator prequel.'}</p>
        </div>
        <div class="al-optin-form-wrap">
          <a class="btn al-btn-dark" href={author.freeBook?.link} target="_blank" rel="noopener">Get the Free Story &amp; Subscribe</a>
          <p class="al-optin-privacy">Your information is safe. Unsubscribe anytime.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- About -->
  <section class="al-section al-section-light" id="about">
    <div class="container">
      <div class="author-hero">
        <img src={author.photo} alt={author.name} class="photo" loading="lazy" />
        <div class="bio-box">
          <h2>{author.name}</h2>
          <div class="genre-list">
            {author.genres.map(g => <span class="tag">{g}</span>)}
          </div>
          <p class="bio-text">{author.bio}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Releases -->
  {latestReleases.length > 0 && (
    <section class="al-section al-latest-releases">
      <div class="container">
        <div class="section-title" style="text-align:left;">
          <span>Latest Releases</span>
        </div>
        <div class="al-releases-grid">
          {latestReleases.map(book => (
            <div class="al-release-card">
              <a href={`/books/${book.id}/`} class="cover-wrap">
                <img src={book.data.cover} alt={book.data.title} loading="lazy" />
              </a>
              <div class="release-info">
                <h3><a href={`/books/${book.id}/`}><mark>{book.data.title}</mark></a></h3>
                <p class="blurb">{book.data.blurb}</p>
                <div class="ml-release-actions">
                  {book.data.buyLinks?.amazon ? (
                    <a href={book.data.buyLinks.amazon} class="btn btn-primary" target="_blank" rel="noopener">
                      Buy on Amazon
                    </a>
                  ) : (
                    <span class="btn-soon">Coming Soon</span>
                  )}
                  <a href={`/books/${book.id}/`} class="ml-release-link">Read More &rarr;</a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Coming Soon -->
  {author.comingSoon && (
    <section class="al-preorder-banner" style={`background-image: url(${author.comingSoon.cover});`}>
      <div class="al-preorder-overlay"></div>
      <div class="al-preorder-inner container">
        {comingSoonBook ? (
          <a href={`/books/${comingSoonBook.id}/`} class="al-preorder-cover">
            <img src={author.comingSoon.cover} alt={author.comingSoon.title} />
          </a>
        ) : (
          <div class="al-preorder-cover">
            <img src={author.comingSoon.cover} alt={author.comingSoon.title} />
          </div>
        )}
        <div class="al-preorder-content">
          <span class="al-preorder-label">Coming Soon</span>
          <h2 class="al-preorder-title">{comingSoonBook ? <a href={`/books/${comingSoonBook.id}/`}>{author.comingSoon.title}</a> : author.comingSoon.title}</h2>
          <p class="al-preorder-blurb">{author.comingSoon.blurb}</p>
          {comingSoonBook ? (
            <a href={`/books/${comingSoonBook.id}/`} class="al-preorder-btn">Read More</a>
          ) : (
            <span class="al-preorder-btn">Preorder Soon</span>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- All Books -->
  {fullCatalog.length > 0 && (
    <section class="al-section" id="all-books">
      <div class="container">
        <div class="section-title" style="text-align:left;">
          <span>All Books</span>
          <h2>By {author.name}</h2>
        </div>
        <div class="book-grid">
          {fullCatalog.map(book => {
            const isFree = book.data.title.trim().toLowerCase() === freeTitle;
            const detailUrl = isFree ? `/free/${author.slug}/` : `/books/${book.id}/`;
            return (
              <div class="card book-card">
                <a href={detailUrl} class="cover-wrap">
                  <img src={book.data.cover} alt={book.data.title} loading="lazy" />
                </a>
                <div class="info">
                  <h4><a href={detailUrl}>{book.data.title}</a></h4>
                  <span class="tag genre-tag">{book.data.genre}</span>
                  <p class="book-card-blurb">
                    {book.data.blurb}
                  </p>
                  {isFree ? (
                    <a href={`/free/${author.slug}/`} class="btn btn-outline book-card-btn">
                      Get It Free
                    </a>
                  ) : book.data.buyLinks?.amazon ? (
                    <a href={book.data.buyLinks.amazon} class="btn btn-outline book-card-btn" target="_blank" rel="noopener">
                      Read on Amazon
                    </a>
                  ) : (
                    <a href={detailUrl} class="btn btn-outline book-card-btn">
                      Read More
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Bottom Newsletter -->
  <section class="al-section al-bottom-newsletter ml-bottom-nl">
    <div class="container">
      <h2 class="al-bottom-nl-heading"><mark class="ml-highlight">Never Miss a New Release</mark></h2>
      <p class="al-bottom-nl-desc">Join {author.name}'s mailing list for exclusive content, early cover reveals, and new release alerts delivered straight to your inbox.</p>
      <a class="btn btn-primary" href={author.freeBook?.link} target="_blank" rel="noopener">Get the Free Story &amp; Subscribe</a>
      <p class="al-bottom-nl-privacy">Your information is safe. Unsubscribe anytime.</p>
    </div>
  </section>

</AuthorLandingLayout>

<style>
  /* ── Madison Lane Blue Theme ── */
  /* Hero */
  :global(.ml-hero) {
    background: #1B3A5C;
    padding: 3rem 0;
    overflow: hidden;
    position: relative;
  }

  :global(.ml-hero-carousel) { position: relative; width: 100%; }
  :global(.ml-hero-slide) { display: none; opacity: 0; transition: opacity 0.5s ease; }
  :global(.ml-hero-slide.active) { display: block; opacity: 1; }
  :global(.ml-hero-arrow) {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 10;
    background: rgba(139, 184, 224, 0.25); border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 50%; width: 48px; height: 48px; display: flex;
    align-items: center; justify-content: center; cursor: pointer; color: #ffffff;
    transition: background 0.2s, border-color 0.2s;
  }
  :global(.ml-hero-arrow):hover { background: #8BB8E0; border-color: #8BB8E0; color: #0f2438; }
  :global(.ml-hero-arrow) svg { width: 22px; height: 22px; }
  :global(.ml-hero-arrow--left) { left: 1.5rem; }
  :global(.ml-hero-arrow--right) { right: 1.5rem; }
  :global(.ml-hero-dots) {
    display: flex; justify-content: center; gap: 0.5rem; padding: 1rem 0 0;
    position: relative; z-index: 10;
  }
  :global(.ml-hero-dot) {
    width: 10px; height: 10px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent; cursor: pointer; transition: background 0.2s, border-color 0.2s; padding: 0;
  }
  :global(.ml-hero-dot.active), :global(.ml-hero-dot):hover { background: #8BB8E0; border-color: #8BB8E0; }

  :global(.ml-hero-inner) {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  :global(.ml-hero-text) {
    flex: 1;
  }

  :global(.ml-hero-title) {
    font-family: 'Poppins', sans-serif;
    font-size: 3.5rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.05;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  :global(.ml-hero-title) a {
    color: inherit;
    text-decoration: none;
  }

  :global(.ml-hero-title) a:hover {
    color: #8BB8E0;
  }

  :global(.ml-hero-actions) {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  :global(.ml-hero-link) {
    color: #ffffff;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.ml-hero-link):hover {
    color: #8BB8E0;
  }

  :global(.ml-release-actions) {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  :global(.ml-release-link) {
    color: #1B3A5C;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  :global(.ml-release-link):hover {
    color: #153049;
  }

  :global(.al-preorder-title) a {
    color: inherit;
    text-decoration: underline;
  }

  :global(.ml-hero-tagline) {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8BB8E0;
    margin-bottom: 1.25rem;
  }

  :global(.ml-hero-blurb) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #c8d8e8;
    margin-bottom: 2rem;
    max-width: 520px;
  }

  :global(.ml-hero-btn) {
    display: inline-block;
    padding: 1rem 3rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: #1B3A5C;
    background: #ffffff;
    border: none;
    border-radius: 4px;
    transition: background 0.2s, transform 0.2s;
  }

  :global(.ml-hero-btn--soon) {
    background: transparent;
    color: #8BB8E0;
    border: 1px dashed #4a6b8c;
    cursor: default;
  }

  :global(.ml-hero-btn--soon):hover {
    background: transparent;
    color: #8BB8E0;
  }

  :global(.ml-hero-btn):hover {
    background: #8BB8E0;
    color: #0f2438;
    transform: translateY(-2px);
  }

  :global(.ml-hero-cover) {
    flex: 0 0 300px;
    align-self: center;
  }

  :global(.ml-hero-cover) img {
    width: 300px;
    display: block;
    border-radius: 4px;
    box-shadow: -8px 4px 30px rgba(0,0,0,0.4);
  }

  /* Opt-in bar */
  :global(.ml-optin-bar) {
    background: #0f2438;
    padding: 1.5rem 0;
  }

  :global(.ml-optin-bar) .al-optin {
    border-color: #1B3A5C;
    background: transparent;
    border: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  :global(.ml-freebook-cover) {
    flex: 0 0 96px;
  }

  :global(.ml-freebook-cover) img {
    width: 96px;
    display: block;
    border-radius: 4px;
    box-shadow: 0 6px 20px rgba(0,0,0,0.45);
  }

  :global(.ml-optin-bar) .al-optin-text {
    flex: 1 1 280px;
  }

  :global(.ml-optin-bar) .al-optin h2 {
    color: #ffffff;
  }

  :global(.ml-optin-bar) .al-optin p {
    color: #c8d8e8;
  }

  :global(.ml-optin-bar) .al-optin-form input[type="text"],
  :global(.ml-optin-bar) .al-optin-form input[type="email"] {
    background: rgba(139, 184, 224, 0.15);
    border-color: #8BB8E0;
    color: #ffffff;
  }

  :global(.ml-optin-bar) .al-optin-form input::placeholder {
    color: #8BB8E0;
  }

  :global(.ml-optin-bar) .al-optin-privacy {
    color: #8BB8E0 !important;
  }

  /* Scroll-to-top navy blue */
  :global(.al-scroll-top) {
    background: #1B3A5C !important;
    border-color: #1B3A5C !important;
    color: #ffffff !important;
  }
  :global(.al-scroll-top):hover {
    background: #8BB8E0 !important;
    border-color: #8BB8E0 !important;
    color: #1B3A5C !important;
  }

  /* Profile photo */
  .author-hero .photo {
    border: none;
    border-radius: 8px;
  }

  /* Blue accent overrides */
  :global(.al-section) .btn-primary {
    background: #1B3A5C;
    color: #ffffff;
  }
  :global(.al-section) .btn-primary:hover {
    background: #ffffff;
    color: #1B3A5C;
    border: 1px solid #1B3A5C;
  }

  :global(.al-section) .btn-outline {
    border-color: #1B3A5C;
    color: #1B3A5C;
  }
  :global(.al-section) .btn-outline:hover {
    background: #1B3A5C;
    color: #ffffff;
  }

  :global(.al-section) .tag:hover,
  :global(.al-section) .tag.active {
    background: #1B3A5C;
    border-color: #1B3A5C;
    color: #ffffff;
  }

  :global(.al-section) .section-title span {
    color: #1B3A5C;
  }

  :global(.al-section) a {
    color: #1B3A5C;
  }
  :global(.al-section) a:hover {
    color: #153049;
  }

  /* Pre-order Banner */
  :global(.al-preorder-banner) {
    position: relative;
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  :global(.al-preorder-overlay) {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(15, 36, 56, 0.8) 0%,
      rgba(15, 36, 56, 0.9) 50%,
      rgba(15, 36, 56, 0.95) 100%
    );
    z-index: 1;
  }

  :global(.al-preorder-inner) {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 3rem;
    padding: 3rem 0;
  }

  :global(.al-preorder-cover) {
    flex: 0 0 220px;
  }

  :global(.al-preorder-cover) img {
    width: 220px;
    border-radius: 4px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.4);
  }

  :global(.al-preorder-content) {
    flex: 1;
  }

  :global(.al-preorder-label) {
    display: inline-block;
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8BB8E0;
    margin-bottom: 1rem;
  }

  :global(.al-preorder-title) {
    font-family: 'Poppins', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  :global(.al-preorder-blurb) {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: #c8d8e8;
    margin-bottom: 2rem;
  }

  :global(.al-preorder-btn) {
    display: inline-block;
    padding: 1rem 3rem;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: #ffffff;
    background: #1B3A5C;
    border: 2px solid #8BB8E0;
    border-radius: 4px;
    transition: background 0.2s, transform 0.2s;
  }

  :global(.al-preorder-btn):hover {
    background: #ffffff;
    color: #1B3A5C !important;
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  /* Latest Releases */
  :global(.al-releases-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  :global(.al-release-card) {
    display: flex;
    gap: 1.5rem;
    align-items: stretch;
  }

  :global(.al-release-card) .cover-wrap {
    flex: 0 0 160px;
  }

  :global(.al-release-card) .cover-wrap img {
    width: 160px;
    border-radius: 4px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  }

  :global(.al-release-card) .release-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  :global(.al-release-card) .release-info h3 {
    color: #1a1a1a;
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  :global(.al-release-card) .release-info h3 mark {
    background: linear-gradient(to top, #1B3A5C40 40%, transparent 40%);
    color: inherit;
    padding: 0 4px;
  }

  :global(.al-release-card) .release-info .blurb {
    color: #444444;
    font-size: 0.9rem;
    line-height: 1.7;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.al-latest-releases) .section-title span {
    position: relative;
    display: inline-block;
  }

  :global(.al-latest-releases) .section-title span::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 100%;
    height: 8px;
    background: #1B3A5C40;
    z-index: -1;
  }

  /* Bottom Newsletter — dark navy like hero */
  :global(.ml-bottom-nl) {
    background: #1B3A5C !important;
    text-align: center;
  }

  :global(.ml-bottom-nl) .al-bottom-nl-heading {
    color: #ffffff;
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }

  :global(.ml-highlight) {
    background: linear-gradient(to top, rgba(139, 184, 224, 0.4) 40%, transparent 40%);
    color: inherit;
    padding: 0 4px;
  }

  :global(.ml-optin-highlight) {
    background: linear-gradient(to top, rgba(139, 184, 224, 0.45) 40%, transparent 40%);
    color: inherit;
    padding: 0 4px;
  }

  :global(.ml-bottom-nl) .al-bottom-nl-desc {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9375rem;
    line-height: 1.7;
    margin-bottom: var(--space-md);
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  :global(.ml-bottom-nl) .al-bottom-nl-form {
    display: flex;
    gap: var(--space-xs);
    max-width: 640px;
    margin: 0 auto;
    flex-direction: row;
  }

  :global(.ml-bottom-nl) .al-bottom-nl-form input[type="text"],
  :global(.ml-bottom-nl) .al-bottom-nl-form input[type="email"] {
    padding: 0.75rem 1rem;
