<script>
  const vrSlides = document.querySelectorAll('.vr-hero-slide') as NodeListOf<HTMLElement>;
  const vrDots = document.querySelectorAll('.vr-hero-dot') as NodeListOf<HTMLButtonElement>;
  const vrPrev = document.getElementById('vrHeroPrev');
  const vrNext = document.getElementById('vrHeroNext');
  let vrCurrent = 0;
  let vrTimer: ReturnType<typeof setInterval>;

  function vrGoToSlide(index: number) {
    vrSlides[vrCurrent]?.classList.remove('active');
    vrDots[vrCurrent]?.classList.remove('active');
    vrCurrent = (index + vrSlides.length) % vrSlides.length;
    vrSlides[vrCurrent]?.classList.add('active');
    vrDots[vrCurrent]?.classList.add('active');
  }

  function vrResetAuto() {
    clearInterval(vrTimer);
    vrTimer = setInterval(() => vrGoToSlide(vrCurrent + 1), 6000);
  }

  vrPrev?.addEventListener('click', () => { vrGoToSlide(vrCurrent - 1); vrResetAuto(); });
  vrNext?.addEventListener('click', () => { vrGoToSlide(vrCurrent + 1); vrResetAuto(); });
  vrDots.forEach(dot => dot.addEventListener('click', () => {
    vrGoToSlide(Number(dot.dataset.dot));
    vrResetAuto();
  }));
  if (vrSlides.length > 1) vrResetAuto();
</script>
